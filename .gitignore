# Track only the custom BoH code: theme, deploy bundle, helper scripts.
# WordPress core, plugins, uploads, and secrets stay out of version control.
/*
!/.gitignore
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/astra-boh/
# Custom mu-plugins (gallery scanner + uploader, invitations, SMTP, Stripe)
!/wp-content/mu-plugins/
# Our own plugin only; third-party plugins stay out of the repo
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/boh-5050/
!/deploy-boh-4.32/
!/restore-evicted.sh
!/CONTENT-EDITING-GUIDE.md
!/5050-ARCHITECTURE-AND-PLAN.md
!/assets/
!/deploy-feedback-to-live.sh

# never commit credentials or archives
wp-config.php
wp-config.php.*
*.zip
